{
  "version": 3,
  "configurePresets": [
    {"name": "dev", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/build/dev", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}},
    {"name": "asan", "inherits": "dev", "binaryDir": "${sourceDir}/build/asan", "cacheVariables": {"RECURSANT_SANITIZERS": "ON"}}
  ],
  "buildPresets": [{"name": "dev", "configurePreset": "dev"}, {"name": "asan", "configurePreset": "asan"}],
  "testPresets": [{"name": "dev", "configurePreset": "dev", "output": {"outputOnFailure": true}}, {"name": "asan", "configurePreset": "asan", "output": {"outputOnFailure": true}}]
}
