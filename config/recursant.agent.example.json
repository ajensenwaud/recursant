{
  "listen": {
    "host": "127.0.0.1",
    "port": 8080
  },
  "providers": [
    {
      "name": "gx10",
      "trust": "private",
      "url": "http://gx10:8888/v1",
      "adapter": "openai-compatible"
    },
    {
      "name": "openrouter",
      "trust": "public",
      "url": "https://openrouter.ai/api/v1",
      "key_env": "OPENROUTER_API_KEY",
      "adapter": "openrouter"
    }
  ],
  "private_default": {
    "provider": "gx10",
    "model": "GLM-5.3-Flash"
  },
  "auth": {
    "api_key_env": "RECURSANT_API_KEY"
  },
  "aliases": [
    {
      "from": "baseline",
      "provider": "openrouter",
      "model": "anthropic/claude-sonnet-5.5"
    },
    {
      "from": "economy",
      "provider": "openrouter",
      "model": "openai/gpt-6-luna"
    },
    {
      "from": "strong",
      "provider": "openrouter",
      "model": "anthropic/claude-opus-5.5"
    },
    {
      "from": "local",
      "provider": "gx10",
      "model": "GLM-5.3-Flash"
    }
  ],
  "limits": {
    "max_body_bytes": 4194304,
    "max_connections": 32,
    "request_timeout_seconds": 600
  },
  "compliance": {
    "enabled": true,
    "public_allowed": true,
    "text_mode": "agent",
    "identifiers": [
      "au_tfn",
      "au_medicare",
      "au_abn",
      "payment_card",
      "au_phone",
      "au_bank_account",
      "passport",
      "drivers_licence",
      "date_of_birth"
    ]
  },
  "context": {
    "mode": "active",
    "tenant": "local",
    "project": "agents",
    "source_key_env": "RECURSANT_SOURCE_KEY",
    "auto_alias": "auto",
    "baseline_alias": "baseline",
    "ttl_ms": 180000,
    "signals": "on",
    "sessions": "request",
    "reasoning_text": "drop",
    "health": {
      "cooldown_ms": 5000,
      "failure_ratio": 0.5,
      "min_requests": 5,
      "max_retries": 2
    },
    "reasoning": "steps",
    "repeat_escalation": "off",
    "housekeeping": {
      "alias": "economy"
    },
    "budgets": {
      "session_usd": 5.0,
      "downshift_at": 0.8,
      "session_requests": 500,
      "requests_per_minute": 600
    },
    "decision_headers": "on",
    "prompt": {
      "weights": {
        "bias": 5
      },
      "vocab": {},
      "simple_min": 0.5
    },
    "candidates": [
      {
        "alias": "baseline",
        "quality_evidence": "HARNESS-DEFAULT-BASELINE",
        "qualified_tasks": [],
        "context_limit": 1000000,
        "price": {
          "input_per_mtok": 2.0,
          "output_per_mtok": 10.0,
          "cached_input_per_mtok": 0.2
        },
        "reasoning": {
          "family": "openrouter",
          "low": "low",
          "high": "low"
        }
      },
      {
        "alias": "economy",
        "quality_evidence": "OPERATOR-QUALIFIED-ROUTINE-STEPS",
        "qualified_tasks": [
          "tool_followup_ok",
          "final_answer",
          "delegated_start",
          "simple_prompt"
        ],
        "context_limit": 1000000,
        "capabilities": {
          "tool_history": true,
          "function_tools": true,
          "parallel_tools": true,
          "reasoning_effort": [
            "low",
            "medium",
            "high"
          ],
          "stream_tools": true,
          "nested_tool_schemas": true
        },
        "price": {
          "input_per_mtok": 0.1,
          "output_per_mtok": 0.5,
          "cached_input_per_mtok": 0.01
        }
      },
      {
        "alias": "strong",
        "quality_evidence": "OPERATOR-QUALIFIED-RECOVERY",
        "qualified_tasks": [],
        "escalation": true,
        "context_limit": 1000000,
        "capabilities": {
          "tool_history": true,
          "function_tools": true,
          "parallel_tools": true,
          "stream_tools": true,
          "nested_tool_schemas": true,
          "reasoning_effort": [
            "low",
            "medium",
            "high"
          ]
        },
        "reasoning": {
          "family": "openrouter",
          "low": "low",
          "high": "low"
        },
        "price": {
          "input_per_mtok": 4.0,
          "output_per_mtok": 20.0,
          "cached_input_per_mtok": 0.2
        }
      },
      {
        "alias": "local",
        "quality_evidence": "PRIVATE-PLACEMENT-AND-ROUTINE",
        "qualified_tasks": [
          "tool_followup_ok",
          "final_answer",
          "simple_prompt"
        ],
        "context_limit": 131072,
        "max_inflight": 4,
        "capabilities": {
          "tool_history": true,
          "function_tools": true,
          "parallel_tools": true
        },
        "reasoning": {
          "family": "vllm-thinking"
        },
        "price": {
          "input_per_mtok": 0.0,
          "output_per_mtok": 0.0
        }
      }
    ]
  }
}
