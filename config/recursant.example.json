{
  "listen": {"host": "0.0.0.0", "port": 8080},
  "private": {"url": "http://gx10:8888/v1", "model": "GLM-5.3-Flash-EXL3"},
  "public": {
    "url": "https://openrouter.ai/api/v1",
    "model": "liquid/lfm-2.5-2.6b:free",
    "api_key_env": "OPENROUTER_API_KEY"
  },
  "auth": {"api_key_env": "RECURSANT_API_KEY"},
  "aliases": [
    {"from": "local", "endpoint": "private", "model": "GLM-5.3-Flash-EXL3"},
    {"from": "cloud", "endpoint": "public", "model": "liquid/lfm-2.5-2.6b:free"}
  ],
  "limits": {
    "max_body_bytes": 1048576,
    "max_connections": 16,
    "request_timeout_seconds": 120
  },
  "compliance": {
    "enabled": true,
    "public_allowed": true,
    "patterns": ["ACCOUNT-[0-9]{4,}"]
  }
}
